# =========================
# Obsidian 本地工作区状态
# =========================

# 这些文件主要记录当前打开的标签页、侧边栏状态、最近访问文件等，
# 对知识库本身没有长期价值，而且多人或多设备下会频繁产生噪音。
.obsidian/workspace.json
.obsidian/graph.json

# =========================
# Obsidian 缓存与可再生文件
# =========================

# 如后续出现缓存目录，默认不纳入版本管理。
.obsidian/cache/

# =========================
# 自动化运行产物与临时文件
# =========================

# 保留日报正文，但忽略脚本运行日志、临时导出和抓取缓存。
logs/
tmp/
temp/
cache/
exports/
data/raw/
data/cache/
*.log

# 粗筛缓存与临时数据文件
data/cache_*.json
data/_screen_*.csv
data/screen_*.json
data/prebuy_*.json
data/temp_*.json

# 脚本目录下的临时数据与临时脚本
scripts/tmp_*.py
scripts/*_data.json

# 环境变量（含 API Token 等敏感信息）
.env
skills/lixinger-api/token.json
.env.*
!.env.example

# =========================
# Python 运行噪音
# =========================

__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.venv/
venv/

# =========================
# 系统文件
# =========================

.DS_Store
Thumbs.db
desktop.ini

# 财报Inbox（原始PDF+临时文件）
财报/_Inbox/
# 临时脚本输出
scripts/_ocr_test.txt
scripts/_pharma_results.json
scripts/_bad_bands.txt
scripts/_fix_bands2.py
bash.exe.stackdump
copilot-session-*

# =========================
# Obsidian 粘贴图片
# =========================
Pasted image *.png
Pasted image *.jpg

# =========================
# 脚本临时/缓存文件
# =========================
scripts/_*.json
scripts/_*.txt
scripts/_*.py
scripts/deep_data/
scripts/runze_deep_data/
scripts/todo_data/
!.gitignore
# =========================
# Eval 运行产物（可再生，体积大不入库）
# =========================
evals/reports/**/live/**/claude_stream.jsonl
evals/reports/**/.live/

# 研究过程产物；证据、底稿和最终裁决保留，见 docs/git-artifact-policy.md
/data/reviews/**/writer/**/*.md
/data/reviews/**/writer/audit-*.py
/data/reviews/**/sol/
/data/reviews/**/astra/
/data/reviews/**/anonymous/
/data/reviews/**/anonymous-recheck/
/data/reviews/**/review-facts/
/data/reviews/**/review-reasoning/
/data/reviews/**/frozen*/
/data/reviews/**/revised-frozen/
/data/reviews/**/originals/
/data/reviews/**/company-pages-before/
/data/reviews/**/drafts/
/data/reviews/**/draft-*
/data/reviews/**/*-draft.*
/data/reviews/**/stage*-request.json
/data/reviews/**/stage*-response.json
/data/reviews/**/*-revision-response.json
/data/reviews/**/input.json
/data/reviews/**/status*.json
/data/reviews/**/*-timing.json
/data/reviews/process-audit-*/

# 自动化运行快照；作为正式结论依据的必要快照归档到 data/research/
/data/api_usage/
/data/screens/
/data/forecast_scan/
/data/tmp_*/
/scripts/_ai_bubble_scan/
/scripts/_weekly_scan/
/scripts/_batch*_staging/
/scripts/_rewrite_staging/
/scripts/_management_archive_cache/
/scripts/broken_links_report.json
/scripts/broken_links_report.txt
/scripts/stock_link_report.txt

# 编辑器临时文件与本地状态
/.obsidian/workspace-mobile.json
*.swp
*.swo
~$*

# 历史任务散落的重复稿、冻结副本与启动流水
/data/reviews/**/frozen-author-draft-*.md
/data/reviews/**/repair-*-snapshot/
/data/reviews/**/revised-deep.md
/data/reviews/**/revised-management.md
/data/reviews/**/revised-valuation.md
/data/reviews/**/*-prior-input.json
/data/reviews/**/usage-start.json
/data/reviews/**/usage-audit*.json
/data/reviews/**/final/author-v1-*
/data/reviews/**/final/author-v2-*
/data/reviews/**/final/author-v3-manifest.md
/data/reviews/**/final/author-v3-tables.md

# 装配输出可从source和底稿再生成，最终正式报告与final清单仍保留
/data/reviews/**/build-v*/
# 名称含final的构建副本也不等于发布依据；正式验收包只放final/release-*/。
/data/reviews/**/build-final/
/data/reviews/**/schema-replay/
