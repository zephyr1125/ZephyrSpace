## 第 3 步：各维度评分

将以下评分代码写入 `scripts/tmp_score_calc.py`：

```python
# ====================================================
# 输入：第1步和第2步采集的数据变量
# 输出：scores字典（key=维度序号, value=0-100分）
# ====================================================

def score_dim1_pe_percentile(cv_3y, cv_5y=None):
    """动态PE历史分位 → 直接转换为0-100分"""
    score = cv_3y * 100
    note = f"3年PE百分位 {cv_3y*100:.1f}%"
    if cv_5y:
        score = (cv_3y * 0.6 + cv_5y * 0.4) * 100  # 3年+5年加权
        note += f"，5年分位 {cv_5y*100:.1f}%（加权均值）"
    return round(score), note

def score_dim1_pe_us(current_pe, benchmarks):
    """美股PE百分位（基于内置历史基准）"""
    p20, p50, p80 = benchmarks["p20_ttm"], benchmarks["p50_ttm"], benchmarks["p80_ttm"]
    if current_pe <= p20:
        score = 10 + (current_pe / p20) * 20
    elif current_pe <= p50:
        score = 30 + ((current_pe - p20) / (p50 - p20)) * 25
    elif current_pe <= p80:
        score = 55 + ((current_pe - p50) / (p80 - p50)) * 20
    else:
        score = 75 + min(25, ((current_pe - p80) / p80) * 50)
    return round(score), f"当前PE {current_pe:.1f}x，历史P20={p20}/P50={p50}/P80={p80}"

def score_dim2_forward_pe(fwd_pe, benchmarks):
    """前瞻PE（仅US，CN类跳过返回None）"""
    p20, p50, p80 = benchmarks["p20_fwd"], benchmarks["p50_fwd"], benchmarks["p80_fwd"]
    if fwd_pe <= p20:                score = 20
    elif fwd_pe <= p50:              score = 30 + (fwd_pe - p20) / (p50 - p20) * 20
    elif fwd_pe <= p80:              score = 50 + (fwd_pe - p50) / (p80 - p50) * 25
    else:                            score = 75 + min(20, (fwd_pe - p80) / p80 * 40)
    return round(score), f"前瞻PE {fwd_pe:.1f}x（历史P20={p20}/P50={p50}/P80={p80}）"

def score_dim3_peg(fwd_pe, growth_pct, index_type="US_TECH"):
    """PEG = 前瞻PE ÷ 预期净利润增速%

    ⚠️ CN_GROWTH 使用规则（重要，避免方法论自相矛盾）：
    - D2（前瞻PE）虽然因独立可靠性低而跳过，但 D3 的 PEG 仍然需要 Forward PE 作为分子。
    - 正确做法：用分析师一致预期 Forward PE（Wind/Bloomberg）÷ 一致预期增速。
      例如：科创50 Forward PE ≈ 80x，增速预期 ≈ 65-70%，PEG ≈ 1.2（合理偏贵）。
    - 若 Forward PE 无法获取，备选：TTM PE ÷ TTM 实际盈利增速 YoY（全用实际数据，不混搭）。
    - 🚫 禁止：TTM PE ÷ 前瞻增速（两者时态不一致，系统性高估"贵"的程度）。
    - 若以上均无可靠数据，返回 None 跳过本维度，不强行打分。

    CN_VALUE 指数同样应优先用 Forward PE / 实际盈利增速，不用 TTM PE 混搭前瞻增速。
    """
    if not fwd_pe or not growth_pct or growth_pct <= 0:
        return None, "PEG无法计算（增速为负或数据缺失）"
    peg = fwd_pe / growth_pct
    if peg < 0.8:      score = 15
    elif peg < 1.0:    score = 30
    elif peg < 1.2:    score = 45
    elif peg < 1.5:    score = 60
    elif peg < 2.0:    score = 75
    else:              score = 90
    return score, f"PEG = {fwd_pe:.1f} ÷ {growth_pct:.0f}% = {peg:.2f}"

def score_dim4_roe(roe_pct):
    """ROE质量（高ROE支撑估值，得分反向）"""
    if not roe_pct:
        return 50, "ROE数据缺失，默认中性50分"
    if roe_pct > 25:   score = 20
    elif roe_pct > 20: score = 35
    elif roe_pct > 15: score = 50
    elif roe_pct > 10: score = 65
    else:              score = 80
    return score, f"加权ROE {roe_pct:.1f}%"

def score_dim5_erp(pe, risk_free_rate_pct, dy_pct=0, index_type="CN_VALUE"):
    """股债利差ERP = max(盈利收益率, 股息率) - 无风险利率

    ⚠️ CN_GROWTH 适用性说明：
    对早期盈利爬坡型指数（如科创50，PE=156x，大量成分股微利或刚扭亏），
    TTM 盈利收益率（1/PE=0.64%）严重低估投资者的真实预期回报，因为
    投资者定价的是未来3-5年利润大幅改善后的回报，而非当期盈利收益率。
    本维度对 CN_GROWTH 仍保留（权重已降至7%），仅作边界条件参考：
    ERP为正 → 说明估值还没到纯泡沫阶段；ERP深度为负 → 需额外谨慎。
    不应以此做"买贵了"的核心判断。

    对 CN_VALUE（沪深300/A500/上证50）和 US_BROAD，ERP具有较强参考意义。
    """
    earnings_yield = (1 / pe * 100) if pe and pe > 0 else 0
    equity_yield = max(earnings_yield, dy_pct)
    erp = equity_yield - risk_free_rate_pct
    if erp > 4:    score = 15
    elif erp > 2:  score = 30
    elif erp > 0:  score = 50
    elif erp > -2: score = 70
    else:          score = 85
    return score, f"ERP = 盈利收益率{equity_yield:.1f}% - 国债{risk_free_rate_pct:.1f}% = {erp:+.1f}%"

def score_dim6_policy(policy_text, is_us=True):
    """央行政策（Tavily文本 → 固定规则打分）"""
    text = policy_text.lower()
    # 判断关键词（优先级从低贵到高贵）
    if any(k in text for k in ["降息25", "降息50", "降息0.25", "降息0.5", "cut rate", "rate cut"]):
        return 20, "当前降息周期中"
    if any(k in text for k in ["降息预期", "预期降息", "75%概率", "有望降息", "expected to cut"]):
        return 40, "有明确降息预期（市场定价>50%）"
    if any(k in text for k in ["暂停降息", "维持不变", "pause", "hold", "按兵不动"]):
        if any(k in text for k in ["年内", "全年", "year", "later"]):
            return 60, "暂停降息，预期模糊或推迟至年底"
        return 55, "暂停降息，关注后续指引"
    if any(k in text for k in ["加息", "hike", "raise rate", "tighten"]):
        return 85, "加息周期或加息风险"
    return 60, "政策信号不明确，默认中性偏贵"

def score_dim7_vix(vix_value=None, cn_sentiment=None):
    """VIX（美股）/ 市场情绪（A股）"""
    if vix_value is not None:
        if vix_value < 15:   score = 75
        elif vix_value < 20: score = 55
        elif vix_value < 25: score = 40
        elif vix_value < 30: score = 30
        else:                score = 15
        return score, f"VIX = {vix_value:.1f}"
    # A股：依赖Tavily描述，用关键词判断
    if cn_sentiment:
        text = cn_sentiment.lower()
        if any(k in text for k in ["缩量", "地量", "成交萎缩", "冷清"]):      return 25, "A股成交量萎缩，市场观望情绪重"
        if any(k in text for k in ["正常", "温和", "平稳"]):                  return 50, "A股市场情绪正常"
        if any(k in text for k in ["放量", "活跃", "成交创新高", "热度"]):     return 65, "A股成交活跃"
        if any(k in text for k in ["疯狂", "暴量", "散户涌入", "全面涨停"]):   return 82, "A股情绪过热，警惕"
    return 50, "波动数据不足，默认中性50分"

def score_dim8_flow(flow_text):
    """资金流入"""
    text = flow_text.lower()
    if any(k in text for k in ["大幅净流入", "创历史新高", "大规模流入", "record inflow"]):
        return 75, "大幅净流入，情绪偏热"
    if any(k in text for k in ["净流入", "持续流入", "inflow", "加仓"]):
        return 55, "温和净流入"
    if any(k in text for k in ["净流出", "持续流出", "outflow", "减仓", "赎回"]):
        return 30, "资金净流出"
    if any(k in text for k in ["大幅流出", "恐慌性赎回", "panic", "massive outflow"]):
        return 15, "大幅净流出，市场恐慌"
    return 48, "资金流向中性"

def score_dim9_etf_premium(premium_pct):
    """ETF溢价率（正=溢价，负=折价）"""
    if premium_pct < -1:    score = 15
    elif premium_pct < 0:   score = 30
    elif premium_pct < 3:   score = 45
    elif premium_pct < 6:   score = 60
    elif premium_pct < 10:  score = 75
    else:                   score = 90
    return score, f"ETF溢价率 {premium_pct:+.2f}%"

def score_dim10_technical(deviation_pct):
    """技术面：价格相对250日均线乖离率"""
    if deviation_pct < -20:       score = 10
    elif deviation_pct < -10:     score = 25
    elif deviation_pct < 0:       score = 45
    elif deviation_pct < 10:      score = 55
    elif deviation_pct < 20:      score = 70
    else:                         score = 85
    return score, f"价格较250日均线乖离 {deviation_pct:+.1f}%"

def score_dim11_geopolitical(geo_text):
    """地缘/宏观风险"""
    text = geo_text.lower()
    if any(k in text for k in ["停火", "缓和", "达成协议", "降低关税", "ceasefire", "de-escalat"]):
        return 25, "地缘/宏观风险缓和"
    if any(k in text for k in ["升级", "冲突扩大", "制裁加码", "衰退预期", "escalat", "recession"]):
        return 75, "地缘/宏观风险升级"
    return 50, "宏观风险中性"

def score_dim12_rebalance(rebal_text):
    """成分股变动"""
    text = rebal_text.lower()
    if any(k in text for k in ["纳入", "ai", "半导体", "科技龙头", "高增速", "added"]):
        if any(k in text for k in ["剔除", "传统", "低增速", "removed"]):
            return 25, "调入优质成长成分，调出低质成分，指数质量提升"
    if any(k in text for k in ["无重大调整", "no major change", "维持"]):
        return 50, "近期无重大成分调整"
    if any(k in text for k in ["纳入传统", "成长性下降", "科技占比降低"]):
        return 75, "成长性成分被稀释"
    return 50, "成分股变动信息不明确，默认中性"

# ====================================================
# 汇总函数
# ====================================================

def calculate_total(scores_dict, weights_dict, index_type):
    w = weights_dict[index_type]
    total = 0.0
    detail = {}
    for dim, score in scores_dict.items():
        if score is None:
            continue  # 跳过无法计算的维度（如CN类的前瞻PE）
        weight = w[dim]
        weighted = score * weight
        total += weighted
        detail[dim] = {"score": score, "weight": weight, "weighted": round(weighted, 2)}
    return round(total, 1), detail

def signal_from_score(total):
    if total < 30:   return "💚 很便宜", "积极建仓 / 大幅增仓"
    if total < 45:   return "🟢 偏便宜", "分批建仓 / 适度增仓"
    if total < 60:   return "🟡 合理中性", "持仓观望，不追高不减仓"
    if total < 75:   return "🟠 偏贵", "不追高，可减仓至标准仓位"
    return "🔴 很贵", "减仓，等待回调机会"
```

