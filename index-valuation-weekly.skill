    f"美联储 关税 经济衰退风险 {today}" if index_type.startswith('US')
    else f"中美关系 经济政策 A股风险 {today}"
)
r_geo = client.search(query_geo, max_results=4, search_depth="basic")

# 搜索4：成分股变动
