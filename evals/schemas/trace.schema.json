{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentTrace",
  "type": "object",
  "required": [
    "case_id",
    "started_at",
    "steps"
  ],
  "properties": {
    "case_id": {
      "type": "string"
    },
    "skill_version": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tool_name",
          "timestamp"
        ],
        "properties": {
          "tool_name": {
            "type": "string"
          },
          "arguments": {
            "type": "object"
          },
          "result_status": {
            "enum": [
              "ok",
              "error",
              "empty",
              "timeout"
            ]
          },
          "result_summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "parent_step": {
            "type": [
              "string",
              "null"
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
